---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { SITE, HOME } from "@consts";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Callout from "@components/Callout.astro";
import LinkCloud from "@components/LinkCloud.astro";
import SkillCloud from "@components/SkillCloud.astro";

const blog = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const projects: CollectionEntry<"projects">[] = (
  await getCollection("projects")
)
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);

const skills = (await getCollection("skills"))
  .sort((a, b) => b.data.id.valueOf() - a.data.id.valueOf());
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <aside data-pagefind-ignore>
      <h1 class="font-semibold text-black dark:text-white">
        👋 Welcome to BrainByteZ - {HOME.DESCRIPTION}
      </h1>
      <div class="space-y-16">
        <section>
          <article class="space-y-4">
            <span>
              <p>
                A new home for
                <Link external href="https://www.brainbytez.nl">
                  BrainByteZ
                </Link>
              </p>
              <p>
                <Callout type="construction">
                  Under construction: fasten your seatbelts💺<br>
                  Things might suddenly break 💔 or change 🔃 during updates.
                </Callout>
              </p>
              <p>
                This site will mostly be focused on tech/geek/gadget/programming stuff.
              </p>
              <p>
                I will also share my applications/projects on this page.<br>
                Feel free to have a look at the 
                <Link href="/projects">
                  projects
                </Link> section or read through the
                <Link href="/blog">
                  blog
                </Link> where I will announce project updates and write about other (tech) topics.
              </p>
              <p>
                My blog posts are written in English (🇺🇸) and/or Dutch (🇳🇱).
              </p>
              <p>
                All my blog posts (comments excluded) are migrated to this
                <Link external href="https://astro.build">
                  Astro
                </Link> 🚀 static-site.<br>
                The current template for this page is the minimalistic
                <Link external href="https://astro-micro.vercel.app">
                  Astro Micro
                </Link> 🔬
              </p>
            </span>
          </article>
        </section>

        <section class="animate space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-y-2">
            <h2 class="font-semibold text-black dark:text-white">
              Latest posts
            </h2>
            <Link href="/blog"> See all posts </Link>
          </div>
          <ul class="not-prose flex flex-col gap-4">
            {
              blog.map((post) => (
                <li>
                  <ArrowCard entry={post} />
                </li>
              ))
            }
          </ul>
        </section>

        <section class="animate space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-y-2">
            <h2 class="font-semibold text-black dark:text-white">
              Recent projects
            </h2>
            <Link href="/projects"> See all projects </Link>
          </div>
          <ul class="not-prose flex flex-col gap-4">
            {
              projects.map((project) => (
                <li>
                  <ArrowCard entry={project} />
                </li>
              ))
            }
          </ul>
        </section>

        <section class="animate space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-y-2">
            <h2 class="font-semibold text-black dark:text-white">
              Skills
            </h2>
          </div>
          <SkillCloud />
        </section>

        <section class="animate space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-y-2">
            <h2 class="font-semibold text-black dark:text-white">
              External links
            </h2>
          </div>
          <LinkCloud />
        </section>
      </div>
    </aside>
  </Container>
</Layout>
