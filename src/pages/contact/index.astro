---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { SITE, CONTACT, SOCIALS, REPOS } from "@consts";
import BackToPrevious from "@components/BackToPrevious.astro";
import LinkButton from "@components/LinkButton.astro";
---

<Layout title={CONTACT.TITLE} description={CONTACT.DESCRIPTION}>
  <Container>
    <aside data-pagefind-ignore>
      <div class="space-y-10">
        <BackToPrevious href="/"> Go to home page </BackToPrevious>
        <section class="animate space-y-4">
          <div class="animate font-semibold text-black dark:text-white">
            Contact Me
          </div>
          <p>
            If you want to contact me, reach out on social media or send a message.
          </p>
          <ul class="not-prose">
            <div class="font-semibold text-black dark:text-white">
              Social Media
            </div>
            <div class="flex flex-wrap gap-2 text-nowrap">
              {
                SOCIALS.map((SOCIAL) => (
                  <li>
                    <LinkButton
                      external
                      href={SOCIAL.HREF}
                      icon={SOCIAL.ICON}
                    >
                      {SOCIAL.NAME}
                    </LinkButton>
                  </li>
                ))
              }
            </div>
          </ul>
          <ul class="not-prose">
            <div class="font-semibold text-black dark:text-white">
              Repositories
            </div>
            <div class="flex flex-wrap gap-2 text-nowrap">
              {
                REPOS.map((REPO) => (
                  <li>
                    <LinkButton
                      external
                      href={REPO.HREF}
                      icon={REPO.ICON}
                    >
                      {REPO.NAME}
                    </LinkButton>
                  </li>
                ))
              }
            </div>
          </ul>
          <ul class="not-prose">
            <div class="font-semibold text-black dark:text-white">
              Mail
            </div>
            <div class="flex flex-wrap gap-2 text-nowrap">
              <li>
                <LinkButton
                  href={`mailto:${SITE.EMAIL}`}
                  icon="mail"
                >
                  Send a message
                </LinkButton>
              </li>
            </div>
          </ul>
        </section>
      </div>
    </aside>
  </Container>
</Layout>
