---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { CONTACT, SOCIALS, PRIVMESSAGES, REPOS } from "@consts";
import BackToPrevious from "@components/BackToPrevious.astro";
import LinkButton from "@components/LinkButton.astro";
import ContactForm from "@components/ContactForm.astro";
---

<Layout title={CONTACT.TITLE} description={CONTACT.DESCRIPTION}>
  <Container>
    <aside data-pagefind-ignore>
      <div class="space-y-10">
        <BackToPrevious href="/"> Go to home page </BackToPrevious>
        <section class="animate space-y-4">
          <div class="animate font-semibold text-black dark:text-white">
            Contact Me
          </div>
          <p>
            If you want to contact me, check out the options below.
          </p>
          <div class="font-semibold text-black dark:text-white">
            Private Message
          </div>
          <div class="flex flex-wrap gap-2 text-nowrap not-prose">
            {
              PRIVMESSAGES.map((PRIVMESSAGE) => (
                <LinkButton
                  external
                  href={PRIVMESSAGE.HREF}
                  icon={PRIVMESSAGE.ICON}
                >
                  {PRIVMESSAGE.NAME}
                </LinkButton>
              ))
            }
          </div>
          <div class="font-semibold text-black dark:text-white">
            Social Media
          </div>
          <div class="flex flex-wrap gap-2 text-nowrap not-prose">
            {
              SOCIALS.map((SOCIAL) => (
                <LinkButton
                  external
                  href={SOCIAL.HREF}
                  icon={SOCIAL.ICON}
                >
                  {SOCIAL.NAME}
                </LinkButton>
              ))
            }
          </div>
          <div class="font-semibold text-black dark:text-white">
            Repositories
          </div>
          <div class="flex flex-wrap gap-2 text-nowrap not-prose">
            {
              REPOS.map((REPO) => (
                <LinkButton
                  external
                  href={REPO.HREF}
                  icon={REPO.ICON}
                >
                  {REPO.NAME}
                </LinkButton>
              ))
            }
          </div>
        </section>
      </div>
      <br>
      <div class="space-y-4">
        <ContactForm icon="send-2" />
      </div>
    </aside>
  </Container>
</Layout>
