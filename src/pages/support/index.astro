---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/Container.astro";
import { SUPPORT, CRYPTOS, DONATIONS } from "@/consts";
import BackToPrevious from "@/components/BackToPrevious.astro";
import CryptoButtonV2 from "@/components/CryptoButtonV2.astro";
import LinkButton from "@/components/LinkButton.astro";
import TextAvatarSignature from "@/components/TextAvatarSignature.astro";
---

<Layout title={SUPPORT.TITLE} description={SUPPORT.DESCRIPTION}>
  <Container>
    <aside data-pagefind-ignore>
      <div class="space-y-10">
        <BackToPrevious href="/"> Go to home page </BackToPrevious>
        <section class="animate space-y-4">
          <div class="animate font-semibold text-black dark:text-white">
            {SUPPORT.TITLE}
          </div>
          <p>
            Articles, tutorials, and projects on BrainByteZ are freely available to everyone.
            If you've found something useful here, consider supporting my work through one of the options below.
          </p>
          <p>
            Support is never expected, but it's always appreciated and encourages me to keep building, learning, and sharing.
          </p>
          <div class="mt-6 flex flex-wrap gap-2 text-nowrap not-prose">
            {
              DONATIONS.map((DONATION) => (
                <LinkButton
                  external
                  href={DONATION.HREF}
                  icon={DONATION.ICON}
                >
                  {DONATION.NAME}
                </LinkButton>
              ))
            }
          </div>
          <div class="text-sm">
            Crypto Donations
          </div>
          <div class="mt-2 flex flex-wrap gap-2 text-nowrap not-prose">
            {
              CRYPTOS.map((CRYPTO) => (
                <CryptoButtonV2
                  uid={CRYPTO.ID}
                  type={CRYPTO.TYPE}
                  address={CRYPTO.ADDRESS}
                  icon={CRYPTO.ICON}
                >
                  {CRYPTO.TYPE}
                </CryptoButtonV2>
              ))
            }
          </div>
        </section>
      </div>
      <TextAvatarSignature size="w-22"/>
    </aside>
  </Container>
</Layout>
