---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { SUPPORT, CRYPTOS, DONATIONS } from "@consts";
import BackToPrevious from "@components/BackToPrevious.astro";
import CryptoButton from "@components/CryptoButton.astro";
import LinkButton from "@components/LinkButton.astro";
---

<Layout title={SUPPORT.TITLE} description={SUPPORT.DESCRIPTION}>
  <Container>
    <aside data-pagefind-ignore>
      <div class="space-y-10">
        <BackToPrevious href="/"> Go to home page </BackToPrevious>
        <section class="animate space-y-4">
          <div class="animate font-semibold text-black dark:text-white">
            Support Me
          </div>
          <p>
            If you want to support me, check out the options below.
          </p>
          <ul class="not-prose">
            <div class="flex flex-wrap gap-2 text-nowrap">
              {
                DONATIONS.map((DONATION) => (
                  <li>
                    <LinkButton
                      external
                      href={DONATION.HREF}
                      icon={DONATION.ICON}
                    >
                      {DONATION.NAME}
                    </LinkButton>
                  </li>
                ))
              }
            </div>
          </ul>
          <ul class="not-prose">
            <div class="flex flex-wrap gap-2 text-nowrap">
              {
                CRYPTOS.map((CRYPTO) => (
                  <li>
                    <CryptoButton
                      type={CRYPTO.TYPE}
                      address={CRYPTO.ADDRESS}
                      icon={CRYPTO.ICON}
                    >
                      {CRYPTO.TYPE}
                    </CryptoButton>
                  </li>
                ))
              }
            </div>
          </ul>
        </section>
      </div>
    </aside>
  </Container>
</Layout>
