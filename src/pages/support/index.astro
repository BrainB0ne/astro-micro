---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { SUPPORT, CRYPTOS, DONATIONS } from "@consts";
import BackToPrevious from "@components/BackToPrevious.astro";
import CryptoButtonV2 from "@components/CryptoButtonV2.astro";
import LinkButton from "@components/LinkButton.astro";
---

<Layout title={SUPPORT.TITLE} description={SUPPORT.DESCRIPTION}>
  <Container>
    <aside data-pagefind-ignore>
      <div class="space-y-10">
        <BackToPrevious href="/"> Go to home page </BackToPrevious>
        <section class="animate space-y-4">
          <div class="animate font-semibold text-black dark:text-white">
            Support Me
          </div>
          <p>
            If you want to support me, check out the options below.
          </p>
          <div class="mt-6 flex flex-wrap gap-2 text-nowrap not-prose">
            {
              DONATIONS.map((DONATION) => (
                <LinkButton
                  external
                  href={DONATION.HREF}
                  icon={DONATION.ICON}
                >
                  {DONATION.NAME}
                </LinkButton>
              ))
            }
          </div>
          <div class="mt-6 flex flex-wrap gap-2 text-nowrap not-prose">
            {
              CRYPTOS.map((CRYPTO) => (
                <CryptoButtonV2
                  uid={CRYPTO.ID}
                  type={CRYPTO.TYPE}
                  address={CRYPTO.ADDRESS}
                  icon={CRYPTO.ICON}
                >
                  {CRYPTO.TYPE}
                </CryptoButtonV2>
              ))
            }
          </div>
        </section>
      </div>
    </aside>
  </Container>
</Layout>
