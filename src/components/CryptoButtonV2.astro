---
type Props = {
  uid: string;
  type: string;
  address: string;
  icon: string;
};

const { uid, type, address, icon } = Astro.props;
---

<button
  class="not-prose group relative flex w-fit flex-nowrap text-sm rounded-sm border border-black/15 py-1.5 pl-7 pr-3 hover:bg-black/5 hover:text-black focus-visible:bg-black/5 focus-visible:text-black dark:border-white/20 dark:hover:bg-white/5 dark:hover:text-white dark:focus-visible:bg-white/5 dark:focus-visible:text-white"
  onclick={`dialog_${uid}.showModal()`}>
    <img 
      class="absolute left-2 top-1/2 size-4 -translate-y-1/2 fill-none stroke-current stroke-2"
      src=`/svg/${icon}.svg`
      alt=`${type}` />
    {type}
</button>

<dialog id=`dialog_${uid}` class="du-modal du-modal-middle">
  <div class="du-modal-box w-fit max-w-(--breakpoint-md) text-sm">
    <h3 class="text-lg font-bold">Thanks for your support!</h3>
    <p class="py-4 text-wrap">
      To donate, please copy-paste the {type} address in your {type} wallet.<br><br>
      1. Select the {type} address below, right-click and select 'Copy'.<br>
      2. Or Click the "Copy to Clipboard" button.<br>
      3. Right-click the address field in your {type} wallet and select 'Paste'.
    </p>
    <div class="py-2">{type} Address</div>
    <address-input data-uid={uid}>
      <input type="text" value={address} id=`address-${uid}` name="address" class="w-full px-2 py-1.5 rounded-sm border border-black/15 dark:border-white/20" readonly />
    </address-input>
    <div class="py-4 flex justify-center-safe">
      <copy-button data-uid={uid}>
        <button
          id=`copy-button-${uid}`
          class="not-prose group relative flex w-fit flex-nowrap text-sm rounded-sm border border-black/15 py-1.5 pl-2.5 pr-3 hover:bg-black/5 hover:text-black focus-visible:bg-black/5 focus-visible:text-black dark:border-white/20 dark:hover:bg-white/5 dark:hover:text-white dark:focus-visible:bg-white/5 dark:focus-visible:text-white"
        />
      </copy-button>
    </div>
    <div class="du-modal-action">
      <form method="dialog">
        <button
          class="not-prose group relative flex w-fit flex-nowrap text-sm rounded-sm border border-black/15 py-1.5 pl-2.5 pr-3 hover:bg-black/5 hover:text-black focus-visible:bg-black/5 focus-visible:text-black dark:border-white/20 dark:hover:bg-white/5 dark:hover:text-white dark:focus-visible:bg-white/5 dark:focus-visible:text-white"
        >❌ Close</button>
      </form>
    </div>
  </div>
</dialog>

<script>
  class ButtonCopy extends HTMLElement {
    connectedCallback() {
      const initialButtonText = "📋 Copy Address to Clipboard";
      const copiedButtonText = "✅ Address Copied to Clipboard";

      const uid = this.dataset.uid?.toString() || "";

      const root = document.getElementById(`copy-button-${uid}`);
      if (!(root instanceof HTMLButtonElement)) return;

      root.innerHTML = initialButtonText;

      // Get the text field
      const copyText = document.getElementById(`address-${uid}`);
      if (!(copyText instanceof HTMLInputElement)) return;

      const activate = () => {
        // Select the text field
        copyText.select();
        copyText.setSelectionRange(0, 99999); // For mobile devices

        // Copy the text inside the text field
        navigator.clipboard.writeText(copyText.value);

        // Change button text to "Copied Address to Clipboard"
        if (root.innerHTML !== copiedButtonText) {
          root.innerHTML = copiedButtonText;
        }
      };

      // click and accessibility activation
      root.addEventListener("click", activate, { once: false });
      root.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          activate();
        }
      }, { once: false });
    }
  }

  class InputAddress extends HTMLElement {
    connectedCallback() {
      const initialButtonText = "📋 Copy Address to Clipboard";

      const uid = this.dataset.uid?.toString() || "";

      const root = document.getElementById(`address-${uid}`);
      if (!(root instanceof HTMLInputElement)) return;

      // Get the button
      const copyButton = document.getElementById(`copy-button-${uid}`);
      if (!(copyButton instanceof HTMLButtonElement)) return;

      const activate = () => {
        // Reset button text
        if (copyButton.innerHTML !== initialButtonText) {
          copyButton.innerHTML = initialButtonText;
        }
      };

      // click and accessibility activation
      root.addEventListener("click", activate, { once: false });
      root.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          activate();
        }
      }, { once: false });
    }
  }

  customElements.define("copy-button", ButtonCopy);
  customElements.define("address-input", InputAddress);
</script>
