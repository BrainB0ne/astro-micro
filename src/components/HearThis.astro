---
type Props = {
  id: string;
  title: string;
};

const { id, title } = Astro.props;
---

<iframe
  title={title}
  style="border-radius: 10px;"
  id=`hearthis_at_track_${id}`
  src=`https://app.hearthis.at/embed/${id}/transparent_black/?hcolor=&color=90afb8&style=2&block_size=2&block_space=1&background=1&waveform=0&cover=0&autoplay=0&css=`
  allowtransparency
  width="100%"
  height="150"/>
