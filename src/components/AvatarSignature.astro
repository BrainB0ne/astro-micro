---
import { Image } from "astro:assets";
import assetsAvatarImage from "../assets/avatar-256.webp";

interface Props {
  size?: "w-16" | "w-18" | "w-20" | "w-22" | "w-24";
}

const { size = "w-22" } = Astro.props;
---

<div class="my-2 flex justify-center">
  <div class="du-tooltip du-tooltip-right" data-tip="— BrainB0ne">
    <div class="du-avatar">
      <div class:list={["rounded", size]}>
        <Image src={assetsAvatarImage} alt="Profile Picture" width={256} height={256} />
      </div>
    </div>
  </div>
</div>
