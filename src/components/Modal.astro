---
const { id, open, type, icon } = Astro.props;
---

<button
  class="not-prose group relative flex w-fit flex-nowrap text-sm rounded-sm border border-black/15 py-1.5 pl-7 pr-3 hover:bg-black/5 hover:text-black focus-visible:bg-black/5 focus-visible:text-black dark:border-white/20 dark:hover:bg-white/5 dark:hover:text-white dark:focus-visible:bg-white/5 dark:focus-visible:text-white"
  onclick={`window.${id}.showModal()`}>
    <img 
      class="absolute left-2 top-1/2 size-4 -translate-y-1/2 fill-none stroke-current stroke-2"
      src=`/svg/${icon}.svg`
      alt=`${type}` />
    {open}
</button>

<dialog
  id={id}
  class="text-sm border py-7 pl-7 pr-7 bg-neutral-100 text-black dark:text-white dark:bg-neutral-900">
  <slot name="main" />
  <form method={id}>
    <slot name="close" />
  </form>
</dialog>

<style>
  /* For the backdrop */
  dialog::backdrop {
    background: rgba(0, 0, 0, 0.5); /* Or a blur effect */
  }

  /* For the dialog element itself */
  dialog {
    position: fixed; /* Stays in viewport */
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%); /* Centers the element */
    /* Add padding, border-radius, shadow as needed */
    padding: 2rem;
    border-radius: 8px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.2);
  }
</style>