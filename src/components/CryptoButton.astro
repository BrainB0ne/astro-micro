---
type Props = {
  uid: string;
  type: string;
  address: string;
  icon: string;
};

const { uid, type, address, icon } = Astro.props;
---

<crypto-button data-uid={uid} data-type={type} data-address={address}>
  <button
    title=`Click to show ${type} address`
    id=`crypto-button-${uid}`
    class="not-prose group relative flex w-fit flex-nowrap rounded-sm border border-black/15 py-1.5 pl-7 pr-3 hover:bg-black/5 hover:text-black focus-visible:bg-black/5 focus-visible:text-black dark:border-white/20 dark:hover:bg-white/5 dark:hover:text-white dark:focus-visible:bg-white/5 dark:focus-visible:text-white"
  >
    <img 
      class="absolute left-2 top-1/2 size-4 -translate-y-1/2 fill-none stroke-current stroke-2"
      src=`/svg/${icon}.svg`
      alt=`${type}` />
    <div class="text-sm">
      <slot />
    </div>
  </button>
</crypto-button>

<script>
  class ButtonCrypto extends HTMLElement {
    connectedCallback() {
      const uid = this.dataset.uid?.toString() || "";
      const type = this.dataset.type?.toString() || "";
      const address = this.dataset.address?.toString() || "";

      const root = document.getElementById(`crypto-button-${uid}`);
      if (!(root instanceof HTMLButtonElement)) return;

      const activate = () => {
        window.prompt(
          `To donate, please copy-paste my ${type} address to your ${type} software - I cannot do it automatically. To copy it, right-click the selected text and select 'Copy'. Then right-click the address field in your ${type} software and select 'Paste'.`,
          `${address}`
        );
      };

      // click and accessibility activation
      root.addEventListener("click", activate, { once: false });
      root.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          activate();
        }
      }, { once: true });
    }
  }

  customElements.define("crypto-button", ButtonCrypto);
</script>
